{
  "name": "keynote-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A self-contained HTML product keynote + scroll-driven site + teaser, with a Gemini/ElevenLabs asset-generation pipeline. Fork it, replace the deck's slides, ship your own.",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "serve": "npx --yes serve deck -l 5188",
    "serve:site": "node scripts/serve.mjs",
    "gen:image": "node scripts/gen-image.mjs",
    "gen:video": "node scripts/gen-video.mjs",
    "gen:voiceover": "node scripts/gen-voiceover.mjs",
    "gen:audio": "node scripts/gen-audio.mjs",
    "shots": "node scripts/screenshot.mjs",
    "pdf": "node scripts/export-pdf.mjs",
    "build:standalone": "node scripts/embed-assets.mjs",
    "export:video": "node scripts/export-video.mjs",
    "export:video:headless": "node scripts/export-video-deterministic.mjs",
    "export:short": "node scripts/export-video.mjs --page /short/index.html#clean --out short.mp4 --seconds 12"
  },
  "dependencies": {
    "@google/genai": ">=1.0.0",
    "lenis": "^1.3.25"
  },
  "devDependencies": {
    "playwright": ">=1.40.0"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
