# Copy this file to ".env" and fill in your key.  (cp .env.example .env)
# Get a key at https://aistudio.google.com/apikey

GEMINI_API_KEY=your_key_here

# --- Optional: pin model ids (verify current ids in the Gemini docs) ---
# Image (Imagen dedicated API):   https://ai.google.dev/gemini-api/docs/imagen
IMAGE_MODEL=imagen-4.0-generate-001
# Image fallback (Gemini native image): https://ai.google.dev/gemini-api/docs/image-generation
IMAGE_MODEL_NATIVE=gemini-2.5-flash-image
# Video (Veo):                    https://ai.google.dev/gemini-api/docs/video
# (leave unset to take the script's own default — it tracks the newest id the pipeline was tested on)
VIDEO_MODEL=veo-3.1-generate-preview

# --- Optional: the house art direction appended to every image and video prompt ---
# gen-image.mjs and gen-video.mjs each carry their own default (deliberately different — see
# docs/assets.md on why "shot on 35mm film" produces a literal filmstrip). Set this to override
# both, or to an empty string to send prompts through raw.
# STYLE_SUFFIX=

# --- ElevenLabs: the autoplay voiceover (scripts/gen-voiceover.mjs) ---
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_key_here
# Pick a voice at https://elevenlabs.io/app/voice-library — open one and copy its id
# (it's in the share link / the API tab), e.g. the stock voice "Rachel":
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# --- Optional: pin the model/output format (verify current ids in the ElevenLabs docs) ---
# https://elevenlabs.io/docs/api-reference/text-to-speech
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# --- Anthropic: only if you drive this repo from an agent (Claude Code, or Keynote Studio) ---
# No script in scripts/ reads this. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_key_here

# --- Optional: the local server (scripts/serve.mjs) ---
# PORT=5179          # auto-increments if taken
# OPEN_AT=/site/     # what to open in the browser on start
# NO_OPEN=1          # don't open a browser at all
